APP_NAME="Web Truyện"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000

# Reverse proxy trust. Leave empty for local/direct access so spoofed
# X-Forwarded-* headers are ignored. Behind a single proxy use REMOTE_ADDR
# (trust only the immediate caller) or list the proxy IPs/CIDRs explicitly.
TRUSTED_PROXIES=
TRUSTED_PROXY_HOPS=1

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────
# Dùng MySQL cho production, SQLite cho local dev
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_truyen
DB_USERNAME=root
DB_PASSWORD=

# Hoặc dùng SQLite (không cần cài MySQL):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/laravel-blade/database/database.sqlite

# ─── Session & Cache ──────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# ─── Queue ────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── Redis (tuỳ chọn, để throttle view counter) ──────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@webtruyen.vn"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Storage ──────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite ─────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# AI: HTTPS API root including version, using the chat/completions protocol.
AI_ENABLED=true
# Response generation shares AI_MAX_CALLS with intent parsing.
AI_CONVERSATIONAL_RESPONSE=true
# Gemini: put the key in AI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY, or
# GOOGLE_AI_API_KEY (legacy AIza... and new AQ... keys) and leave
# AI_MODEL/AI_BASE_URL empty. The app fills the Gemini OpenAI-compatible endpoint
# and a default model. Set AI_MODEL to pin another Gemini model.
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Optional Gemini-only overrides.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Set to false only for providers that reject response_format=json_object.
# AI_JSON_MODE=true
AI_TIMEOUT=15
AI_RETRY_TIMES=1
AI_MAX_CALLS=10
AI_RATE_LIMIT_DECAY=60
AI_PARSE_CACHE_TTL=600
# Short per-conversation transcript for multi-turn context (cache-backed).
AI_MEMORY_TURNS=8
AI_MEMORY_TTL=21600
